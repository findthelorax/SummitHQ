{
    "compilerOptions": {
        "target": "ES2020",
        "outDir": "dist",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["es2020"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "types/*": ["src/types/*"]
        }
    },
    "include": ["src", "scripts"]
}