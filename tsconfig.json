{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": [
            "es2020",
            "dom"
        ],
        "moduleResolution": "Node",
        "baseUrl": ".",
        "paths": {
            "shared/*": ["shared/*"]
        },
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["shared", "client", "server"]
}