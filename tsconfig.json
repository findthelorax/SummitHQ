{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": [
            "es2020",
            "dom"
        ],
        "moduleResolution": "Node",
        "baseUrl": ".",
        "paths": {
            "types/*": ["server/src/types/*"]
        },
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["client", "server"]
}